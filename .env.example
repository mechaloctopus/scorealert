# ============================================================================
# ScoreAlert backend environment. Copy to backend/.env and fill in.
# NEVER commit real values. NEVER ship any of these inside the Android APK.
# ============================================================================

# --- Supabase / Postgres ---------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/scorealert
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # server-side ONLY

# --- eBay Browse API (the one automated source in the MVP) -----------------
# Register an app at https://developer.ebay.com. Client credentials grant.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION          # or SANDBOX
# Kauaʻi buyer context: postal code + delivery country for local-pickup search
EBAY_PICKUP_POSTAL_CODE=96766   # Līhuʻe
EBAY_MARKETPLACE_ID=EBAY_US

# --- Firebase Cloud Messaging (push) ---------------------------------------
# HTTP v1 API uses a service account. Point at the JSON, do NOT inline the key here.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Email ingestion -------------------------------------------------------
# Inbound webhook shared secret (e.g. from SendGrid/Mailgun/CloudMailin parse).
EMAIL_INGEST_SECRET=change-me

# --- Manual share ingestion ------------------------------------------------
SHARE_INGEST_SECRET=change-me

# --- LLM (optional, classification fallback + summaries) -------------------
# Left blank = deterministic-only. The engine never *requires* an LLM.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_MONTHLY_CALLS=2000   # cost guard

# --- Server ----------------------------------------------------------------
PORT=8080
